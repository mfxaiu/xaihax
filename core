CloseBtn.MouseButton1Click:Connect(function()
    scriptRunning = false
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Highlight") then v:Destroy() end
    end
    ScreenGui:Destroy()
end)

local function isKeyPressed(key)
    if not key or not scriptRunning then return false end
    if key.EnumType == Enum.UserInputType then
        return UserInputService:IsMouseButtonPressed(key)
    elseif key.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(key)
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gp)
    if isListeningForKey and not gp and scriptRunning then
        if input.UserInputType.Name:find("MouseButton") then
            Config.AimKey = input.UserInputType
        elseif input.KeyCode ~= Enum.KeyCode.Unknown then
            Config.AimKey = input.KeyCode
        end
        isListeningForKey = false
        for _, b in ipairs(buttons) do b.update() end
    end
end)

local targets = {}
local function updateTargets()
    if not scriptRunning then return end
    targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then table.insert(targets, p.Character) end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj ~= LocalPlayer.Character then
            table.insert(targets, obj)
        end
    end
end

task.spawn(function()
    while scriptRunning and task.wait(1.8) do
        updateTargets()
    end
end)

RunService.RenderStepped:Connect(function()
    if not scriptRunning then return end
    local col = Config.ESPColors[Config.ColorIndex]

    for _, char in ipairs(targets) do
        if char and char.Parent then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hl = char:FindFirstChildOfClass("Highlight")
                if Config.ESP then
                    if not hl then hl = Instance.new("Highlight", char) end
                    hl.Enabled = true
                    hl.FillColor = col
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                elseif hl then hl.Enabled = false end
            end
        end
    end

    if Config.Aimbot and isKeyPressed(Config.AimKey) then
        local closest, minDist = nil, Config.FOV
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

        for _, char in ipairs(targets) do
            local root = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < minDist then
                        minDist = d
                        closest = root
                    end
                end
            end
        end

        if closest then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
