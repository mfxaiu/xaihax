local buttons = {}

local function createButton(text, yPos, configKey, isColorBtn, isDiscordBtn, isKeybindBtn)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92,0,0,42)
    btn.Position = UDim2.new(0.04,0,0,yPos)
    btn.BackgroundColor3 = Color3.fromRGB(25,30,55)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.Parent = Content
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,10)

    local function update()
        if isKeybindBtn then
            btn.Text = "AIM KEY: " .. (Config.AimKey and Config.AimKey.Name or "None")
        elseif isColorBtn then
            btn.Text = "COLOR: " .. Config.ColorNames[Config.ColorIndex]
            btn.TextColor3 = Config.ESPColors[Config.ColorIndex]
        elseif isDiscordBtn then
            btn.Text = "DISCORD"
            btn.BackgroundColor3 = Color3.fromRGB(88,101,242)
        else
            local state = Config[configKey] and " [ON]" or " [OFF]"
            btn.Text = text .. state
            btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0,170,100) or Color3.fromRGB(170,40,40)
        end
    end

    btn.MouseButton1Click:Connect(function()
        if isKeybindBtn then
            isListeningForKey = true
            btn.Text = "PRESS ANY KEY..."
            btn.BackgroundColor3 = Color3.fromRGB(255,140,0)
        elseif isColorBtn then
            Config.ColorIndex = (Config.ColorIndex % #Config.ESPColors) + 1
        elseif isDiscordBtn then
            if setclipboard then setclipboard(DiscordLink) end
            StarterGui:SetCore("SendNotification",{Title="XAI",Text="Link Copied!",Duration=3})
        else
            Config[configKey] = not Config[configKey]
        end
        update()
    end)

    table.insert(buttons, {update = update})
    update()
end

