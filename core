local buttons={}
local function addBtn(txt,y,key,col,disc,keyb)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0.92,0,0,42)
    b.Position=UDim2.new(0.04,0,0,y)
    b.BackgroundColor3=Color3.fromRGB(25,30,55)
    b.TextColor3=Color3.new(1,1,1)
    b.Font=Enum.Font.GothamSemibold
    b.TextSize=14
    b.Parent=content
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,10)

    local function up()
        if keyb then b.Text="AIM KEY: "..(Config.AimKey and Config.AimKey.Name or "None")
        elseif col then b.Text="COLOR: "..Config.ColorNames[Config.ColorIndex];b.TextColor3=Config.ESPColors[Config.ColorIndex]
        elseif disc then b.Text="DISCORD";b.BackgroundColor3=Color3.fromRGB(88,101,242)
        else b.Text=txt..(Config[key]and" [ON]"or" [OFF]");b.BackgroundColor3=Config[key]and Color3.fromRGB(0,170,100)or Color3.fromRGB(170,40,40)end
    end

    b.MouseButton1Click:Connect(function()
        if keyb then
            isListening=true
            b.Text="PRESS ANY KEY..."
            b.BackgroundColor3=Color3.fromRGB(255,140,0)
        elseif col then Config.ColorIndex=(Config.ColorIndex%#Config.ESPColors)+1
        elseif disc then
            if setclipboard then setclipboard(DiscordLink)end
            StarterGui:SetCore("SendNotification",{Title="XAI",Text="Link Copied!",Duration=3})
        else Config[key]=not Config[key]end
        up()
    end)
    table.insert(buttons,{update=up})
    up()
end

